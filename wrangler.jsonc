{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers & Pages).
  "name": "blurr3dcouk",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Serve the site on the real domain. Applied on production deploys (main branch).
  "routes": [
    { "pattern": "blurr3d.co.uk", "custom_domain": true },
    { "pattern": "www.blurr3d.co.uk", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
